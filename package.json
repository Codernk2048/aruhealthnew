{
  "name": "aruhealth",
  "private": true,
  "version": "0.1.0",
  "description": "ARUHEALTH - calm health & wellness platform (EN/NE)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,green \"npm run dev -w @aruhealth/api\" \"npm run dev -w @aruhealth/web\"",
    "dev:api": "npm run dev -w @aruhealth/api",
    "dev:web": "npm run dev -w @aruhealth/web",
    "build": "npm run build -w @aruhealth/web",
    "build:api": "npm run build -w @aruhealth/api",
    "db:setup": "npm run db:setup -w @aruhealth/api",
    "seed": "npm run seed -w @aruhealth/api",
    "lint": "npm run lint -w @aruhealth/web"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "sharp@0.33.5": true
  }
}
